# Leave blank for the local Vite proxy. Set the Worker origin for a Pages build.
VITE_API_BASE_URL=
# The public Firebase web config is already in src/firebase.ts.
# Optional overrides for another Firebase project:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
